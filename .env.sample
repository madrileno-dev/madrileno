# app
APP_ENVIRONMENT=dev
APP_VERSION=v1
# http
INTERFACE="0.0.0.0"
PORT=9000
BASE_URL="http://localhost:9000"
# Ember waits up to this duration for in-flight requests to complete on SIGTERM before exiting.
# HTTP_SHUTDOWN_TIMEOUT="30s"
# cors — empty = any origin in dev, otherwise the BASE_URL host; in prod set to your frontend origin(s), comma-separated ("*" = any)
CORS_ALLOWED_ORIGINS=
# CORS_ENABLED=true
# CORS_MAX_AGE=1h

# observability — points at the openobserve container started by docker-compose.yml
# UI: http://localhost:55080 (login: root@example.com / Complexpass#123)
# Basic header below is base64("root@example.com:Complexpass#123")
# OO requires the org segment in the path; the OTLP SDK rejects a path on the unified endpoint,
# so we use signal-specific endpoints (which permit paths).
# true with the Postgres-only dev stack; false once OpenObserve runs (docker compose --profile full up -d)
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS="authorization=Basic cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM="
OTEL_SERVICE_NAME="madrileno"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:55080/api/default/v1/traces"
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT="http://localhost:55080/api/default/v1/metrics"
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://localhost:55080/api/default/v1/logs"
# with OTEL_SDK_DISABLED=false, serves Prometheus metrics at http://localhost:9464/metrics as well as pushing OTLP
# OTEL_METRICS_EXPORTER=otlp,prometheus

# pg — docker-compose maps to host 55432 to avoid clashing with a local Postgres
PG_HOST='localhost'
PG_PORT=55432
PG_DATABASE=madrileno
PG_USER=postgres
PG_PASSWORD=postgres
# records bound parameter values on query spans; keep off anywhere the trace store is shared
PG_TELEMETRY_CAPTURE_PARAMETERS=true

# mailer — log writes each mail to the application log; smtp delivers to Mailpit from the full profile
# (SMTP on 51025, UI/API at http://localhost:58025)
MAILER_SENDER=log
MAILER_HOST='localhost'
MAILER_PORT=51025
MAILER_FROM_ADDRESS='noreply@example.com'
MAILER_TLS=false

# keys the fingerprints that stand in for credentials in log lines (HMAC-SHA256); any random string, at least 32 characters outside dev
FINGERPRINT_SECRET='fingerprint-secret'

# jwt — signs session tokens (HS256); at least 32 random characters outside dev
JWT_SECRET='secret'

# refresh tokens — ISO-8601 duration each issued token lives (rotation mints a fresh window, so this is an inactivity timeout); default P90D
# REFRESH_TOKEN_VALID_FOR=P90D
# a replay of a just-used refresh token within this window gets the same successor delivered again (a client that lost the
# rotation response retries into this); outside it, or once the successor was used, a replay revokes the family. PT0S disables re-delivery.
# REFRESH_TOKEN_REUSE_GRACE=PT30S
# absolute session lifetime: a refresh-token family is revoked once this old regardless of activity; default P365D
# REFRESH_TOKEN_MAX_FAMILY_AGE=P365D

# admin Basic Auth (gates /admin/*); outside dev the password needs at least 16 characters
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# storage — disk keeps objects under uploads/ and needs no service; s3 uses the Silo container from the full profile
OBJECT_STORAGE=disk
# STORAGE_DISK_ROOT=uploads
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=madrileno
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# firebase (Firebase auth is enabled when FIREBASE_PROJECT_ID is set)
FIREBASE_PROJECT_ID=''

# dev auth — `POST /v1/auth/dev {"email":"..."}` mints a session for any email.
# Local dev only; never enable in deployments.
DEV_AUTH_ENABLED=true

# OIDC primary slot (one provider via env vars; the OIDC_PROVIDER_NAME becomes the path segment of POST /v1/auth/oidc/<name>)
OIDC_PROVIDER_NAME='oidc'
OIDC_ISSUER=''
OIDC_AUDIENCE=''
OIDC_JWKS_URI=''

# dev
# Uncomment for relaxed compile flags locally (skip -Werror). See docs/dev-workflow.md.
# SBT_TPOLECAT_DEV=true
